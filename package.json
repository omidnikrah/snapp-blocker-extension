{
  "name": "snapp-blocker",
  "version": "1.0.0",
  "description": "Block shops on Snappfood and Snapp Market and never see them again.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
